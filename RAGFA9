local function UpdateLighting()
    local L = game:GetService("Lighting")
    if Toggles.EnableTime and Toggles.EnableTime.Value then
        L.ClockTime = Options.WorldClockTime.Value
    else
        L.ClockTime = DefaultLighting.ClockTime
    end
    if Toggles.EnableBrightness and Toggles.EnableBrightness.Value then
        L.Brightness = Options.WorldBrightness.Value
    else
        L.Brightness = DefaultLighting.Brightness
    end
    if Toggles.EnableColors and Toggles.EnableColors.Value then
        L.Ambient = Options.WorldAmbient.Value
        L.OutdoorAmbient = Options.WorldOutdoorAmbient.Value
    else
        L.Ambient = DefaultLighting.Ambient
        L.OutdoorAmbient = DefaultLighting.OutdoorAmbient
    end
end

